{
  "manifest_version": 3,
  "name": "Chrome Bookmark Checker",
  "version": "1.0.1",
  "description": "Scan, validate, and clean up your Chrome bookmarks for broken links and duplicates.",
  "permissions": [
    "bookmarks",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "options_page": "dashboard.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
